# syntax=docker/dockerfile:1.7
# CYB691 edge image: edge-collector, edge-sync, handoff-unpack (standard library only)
# Build from the repo root (docker compose does this for you):
#   docker build -f deploy/docker/Containerfile.edge -t cyb691/edge:local .
# Pin BASE_IMAGE by digest for release builds.
ARG BASE_IMAGE=python:3.12.8-slim-bookworm
FROM ${BASE_IMAGE}
ARG GIT_SHA=unknown
LABEL org.opencontainers.image.title="cyb691-edge" org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.source="https://github.com/rachidafaf/CYB691-IT691-CapstoneProjectFall2026"
# Mount points owned by the service UID, so fresh named volumes inherit the ownership.
RUN groupadd --system --gid 10001 cyb691 && useradd --system --uid 10001 --gid 10001 --no-create-home cyb691 \
 && mkdir -p /data /replay /landing && chown 10001:10001 /data /replay /landing \
 && chmod 0750 /data /replay /landing
COPY --chown=root:root deploy/common /app/common
COPY --chown=root:root deploy/edge /app/edge
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    CYB691_EDGE_DATA_DIR=/data CYB691_EDGE_DB_PATH=/data/edge_queue.db CYB691_LANDING_DIR=/landing
WORKDIR /app
USER 10001:10001
# No EXPOSE: the edge image listens on nothing, and compose runs it with network_mode: none.
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s \
  CMD ["python", "-c", "import sys; sys.path.insert(0,'/app'); from edge import edge_database as d; sys.exit(0 if d.run_integrity_check()[0] else 1)"]
ENTRYPOINT ["python", "-m"]
CMD ["edge.edge_collector"]
